{
  "manifest_version": 3,
  "name": "LootKeeper",
  "version": "3.4",
  "description": "每天定時自動領取《逆水寒》VIP 禮包與每週簽到，支援補領、手動觸發、自訂時間、登入過期通知與執行記錄。作者：墨染楓（瑤光聽雪）。",
  "permissions": ["alarms", "tabs", "storage", "windows", "notifications", "cookies"],
  "host_permissions": [
    "https://www.swordofjustice.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*.163.com/*",
    "https://*.easebar.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.swordofjustice.com/h5/20260424/*"],
      "js": ["targets.js", "claim-core.js", "claim-vip.js"]
    },
    {
      "matches": ["https://www.swordofjustice.com/h5/20260722/*"],
      "js": ["targets.js", "claim-core.js", "claim-checkin.js"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LootKeeper",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "author": "墨染楓（瑤光聽雪）",
  "homepage_url": "https://github.com/ZhouYuXun/LootKeeper"
}
